# Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.env
**/.env
**/.env.*
Backend/.env
Frontend/.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.backup
*.env.backup

# Never ignore example templates
!**/.env.example

# Private Keys, Certificates, & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
service_account*.json
client_secret*.json

# Local SQLite & Database files
*.db
*.sqlite
*.sqlite3
Backend/*.db
Backend/study_assistant.db

# Uploaded Files & Temporary Storage
Backend/uploads/*
!Backend/uploads/.gitkeep
Backend/scratch_test.py
scratch/
*.scratch.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# ==============================================================================
# AI STUDY ASSISTANT - BACKEND CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' inside the Backend/ folder and populate with your keys.
# NEVER commit or share your real '.env' file.
# ==============================================================================

# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Web Search API Key (Get at: https://app.tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase Project Configuration (Get at: https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Application URL (Frontend origin allowed by CORS)
APP_URL=http://localhost:5173

# Server Network Settings (Optional)
HOST=0.0.0.0
PORT=8000

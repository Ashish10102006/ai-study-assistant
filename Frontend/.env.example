# ==============================================================================
# AI STUDY ASSISTANT - FRONTEND CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' inside the Frontend/ folder and configure as needed.
# NEVER include private service role keys or backend secrets in Frontend!
# ==============================================================================

# Supabase Project URL and Public Anon Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Backend API URL (Use http://localhost:8000 for local development)
VITE_API_URL=http://localhost:8000